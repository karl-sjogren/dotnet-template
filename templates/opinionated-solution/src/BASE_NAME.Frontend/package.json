{
  "name": "BASE_NAME.frontend",
  "packageManager": "yarn@4.18.0",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint:css": "stylelint (styles|static)/**/*.{scss,css}",
    "lint:js": "eslint scripts/**/*.{js,mjs}",
    "test": "vitest run",
    "test:chrome": "vitest run --browser.name=chrome --browser.headless",
    "test:safari": "vitest run --browser.name=safari",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --coverage",
    "test:coverage-report": "vitest run --coverage && npx --yes open-cli ./coverage/index.html",
    "test:ci": "vitest run --reporter=junit --coverage --outputFile=test-results/junit.xml"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-plugin": "^5.3.0",
    "@testing-library/dom": "^10.4.2",
    "@vitest/browser": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-jsdoc": "^64.5.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.1.0",
    "jsdom-testing-mocks": "^1.16.0",
    "postcss": "^8.5.28",
    "postcss-scss": "^4.0.9",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2",
    "undici": "^8.10.2",
    "vite": "^8.3.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^5.0.1",
    "webdriverio": "^9.31.9"
  }
}
